{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "separation-practice-config.schema.json",
	"title": "Aircraft Simulator Separation Practice Config",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"settings",
		"separationPracticeSettings",
		"stats",
		"proximities"
	],
	"properties": {
		"settings": {
			"$ref": "#/definitions/settings"
		},
		"separationPracticeSettings": {
			"$ref": "#/definitions/separationPracticeSettings"
		},
		"stats": { "$ref": "./shared-config.schema.json#/definitions/stats" },
		"proximities": {
			"$ref": "./shared-config.schema.json#/definitions/proximities"
		}
	},
	"definitions": {
		"settings": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"playbackSpeed",
				"secondsPerUpdate",
				"vRange",
				"statsDecimalPlaces",
				"proximityDecimalPlaces"
			],
			"properties": {
				"playbackSpeed": {
					"$ref": "./shared-config.schema.json#/definitions/playbackSpeed"
				},
				"secondsPerUpdate": {
					"$ref": "./shared-config.schema.json#/definitions/secondsPerUpdate"
				},
				"vRange": {
					"$ref": "./shared-config.schema.json#/definitions/vRange"
				},
				"statsDecimalPlaces": {
					"$ref": "./shared-config.schema.json#/definitions/statsDecimalPlaces"
				},
				"proximityDecimalPlaces": {
					"$ref": "./shared-config.schema.json#/definitions/proximityDecimalPlaces"
				}
			}
		},
		"separationPracticeSettings": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"startTimeRange",
				"minSeparationRange",
				"leadSpeedRange",
				"angleRange",
				"speedDifferenceRange"
			],
			"properties": {
				"startTimeRange": {
					"type": "object",
					"markdownDescription": "Range of possible start times of the simulation in minutes. Time 0 is the time of closest proximity. Therefore, start times should be negative.\n\nThe value is randomly chosen between the min and max.",
					"additionalProperties": false,
					"required": ["min", "max"],
					"properties": {
						"min": {
							"type": "number",
							"minimum": -20,
							"maximum": -1
						},
						"max": {
							"type": "number",
							"minimum": -20,
							"maximum": -1
						}
					}
				},
				"minSeparationRange": {
					"type": "object",
					"markdownDescription": "Range of possible closest proximities of the aircraft in NM.\n\nThe value is randomly chosen between the min and max.",
					"additionalProperties": false,
					"required": ["min", "max"],
					"properties": {
						"min": {
							"type": "number",
							"minimum": 0,
							"maximum": 10
						},
						"max": {
							"type": "number",
							"minimum": 0,
							"maximum": 10
						}
					}
				},
				"leadSpeedRange": {
					"type": "object",
					"markdownDescription": "Range of possible speeds for the lead aircraft in TAS.\n\nThe value is randomly chosen between the min and max.",
					"additionalProperties": false,
					"required": ["min", "max"],
					"properties": {
						"min": {
							"type": "number",
							"minimum": 0
						},
						"max": {
							"type": "number",
							"minimum": 0
						}
					}
				},
				"angleRange": {
					"type": "object",
					"markdownDescription": "Range of possible intercept angles of the aircraft in degrees.\n\nThe value is randomly chosen between the min and max.",
					"additionalProperties": false,
					"required": ["min", "max"],
					"properties": {
						"min": {
							"type": "number",
							"minimum": 0,
							"exclusiveMaximum": 360
						},
						"max": {
							"type": "number",
							"minimum": 0,
							"exclusiveMaximum": 360
						}
					}
				},
				"speedDifferenceRange": {
					"type": "object",
					"markdownDescription": "Range of possible speed differences between the lead and trailing aircraft in knots. Negative means faster in back, positive means faster in front.\n\nThe value is randomly chosen between the min and max.",
					"additionalProperties": false,
					"required": ["min", "max"],
					"properties": {
						"min": {
							"type": "number"
						},
						"max": {
							"type": "number"
						}
					}
				}
			}
		}
	}
}
