{
	"files.exclude": {
		"**/.vscode/chrome-debug-profile": true
	},
	"files.watcherExclude": {
		"**/.vscode/chrome-debug-profile/**": true
	},
	"search.exclude": {
		"**/.vscode/chrome-debug-profile/**": true
	},
	"json.schemas": [
		{
			"fileMatch": ["/src/config.json"],
			"url": "./src/config.schema.json"
		},
		{
			"fileMatch": ["/src/separation-practice-config.json"],
			"url": "./src/separation-practice-config.schema.json"
		}
	]
}
