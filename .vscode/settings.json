{
	"files.exclude": {
		"**/.vscode/chrome-debug-profile": true
	},
	"files.watcherExclude": {
		"**/.vscode/chrome-debug-profile/**": true
	},
	"search.exclude": {
		"**/.vscode/chrome-debug-profile/**": true
	},
	"json.schemas": [
		{
			"fileMatch": [
				"/src/config/config.json",
				"/src/config/default-config.json"
			],
			"url": "./src/config/schemas/config.schema.json"
		},
		{
			"fileMatch": [
				"/src/config/separation-practice-config.json",
				"/src/config/default-separation-practice-config.json"
			],
			"url": "./src/config/schemas/separation-practice-config.schema.json"
		}
	]
}
